resource app_flags B_SINGLE_LAUNCH;

resource app_signature "application/x-vnd.Globe";

resource app_version {
	major = 0,
	middle = 1,
	minor = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Globe 0.1",
	long_info = "Globe web editor"
};

resource file_types message {
	"types" = "text/html",
	"types" = "text/x-php",
	"types" = "text/plain"
};

resource(100, "about-artwork.png") #'PNG ' import "about-artwork.png";
